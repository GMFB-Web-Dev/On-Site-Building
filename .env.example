# Vercel server-side variables. Enter plain values, without backslashes or trailing slashes.
PAYLOAD_CMS_URL=https://payload.gmfb.co.nz
PAYLOAD_TENANT_ID=7
PAYLOAD_TENANT_SLUG=onsite-build
# Set privately to the same value as Payload's ONSITE_BUILD_REVALIDATION_SECRET.
REVALIDATION_SECRET=

# Public Google identifiers; GTM-NQCNX9N7 is the app's default container.
NEXT_PUBLIC_GTM_ID=GTM-NQCNX9N7
# Optional Search Console HTML verification content value, not an entire meta tag.
GOOGLE_SITE_VERIFICATION=

# Required for sending form notifications and customer acknowledgements. Server-only.
RESEND_API_KEY=
# Optional overrides; these defaults work with the connected account's verified sending domain.
CONTACT_FROM_EMAIL="On Site Building Construction <forms@weblaunch.co.nz>"
CONTACT_TO_EMAIL=onsitebuilding1@gmail.com
CONTACT_SEND_ACKNOWLEDGEMENT=true
